# Copy to .env for local overrides. Values here are development-only placeholders.
POSTGRES_USER=accelerator
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=accelerator
POSTGRES_PORT=5432
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
API_ENVIRONMENT=development
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
# Set these public Entra app-registration values for local authentication.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_WEB_CLIENT_ID=
ENTRA_API_SCOPE=
INGESTION_LOG_LEVEL=INFO
# Azurite's published emulator account (not a secret). The worker uses it only
# when the Search and Foundry embedding settings are also set.
AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;
# API service settings. Development and test may leave Azure services unset and
# fall back to local fakes; API_ENVIRONMENT=production fails fast unless every
# value below is set, the database uses managed identity, and endpoints use HTTPS.
API_DATABASE_URL=postgresql+asyncpg://accelerator:local-development-only@localhost:5432/accelerator
API_DATABASE_AUTH_MODE=password
# User-assigned managed identity client ID (required in production).
AZURE_CLIENT_ID=
API_FOUNDRY_PROJECT_ENDPOINT=
API_FOUNDRY_MODEL_DEPLOYMENT=
API_FOUNDRY_EMBEDDING_DEPLOYMENT=
API_SEARCH_ENDPOINT=
API_SEARCH_INDEX_NAME=
API_SEARCH_VECTOR_DIMENSIONS=
# Sufficiency gate; reranker_score (0-4) needs semantic ranking on the Search service.
API_SEARCH_SEMANTIC_RANKING=true
API_SUFFICIENCY_SCORE_FIELD=reranker_score
API_SUFFICIENCY_MIN_SCORE=2.0
APPLICATIONINSIGHTS_CONNECTION_STRING=
