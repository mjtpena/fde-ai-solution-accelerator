# Copy to .env for local overrides. Values here are development-only placeholders.
POSTGRES_USER=accelerator
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=accelerator
POSTGRES_PORT=5432
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
API_ENVIRONMENT=development
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
# Set these public Entra app-registration values for local authentication.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_WEB_CLIENT_ID=
ENTRA_API_SCOPE=
INGESTION_LOG_LEVEL=INFO
# API service settings. Development and test may leave Azure services unset and
# fall back to local fakes; API_ENVIRONMENT=production fails fast unless every
# value below is set, the database uses managed identity, and endpoints use HTTPS.
API_DATABASE_URL=postgresql+asyncpg://accelerator:local-development-only@localhost:5432/accelerator
API_DATABASE_AUTH_MODE=password
API_FOUNDRY_PROJECT_ENDPOINT=
API_FOUNDRY_MODEL_DEPLOYMENT=
API_SEARCH_ENDPOINT=
API_SEARCH_INDEX_NAME=
APPLICATIONINSIGHTS_CONNECTION_STRING=
