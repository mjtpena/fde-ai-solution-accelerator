{
  "openapi": "3.1.0",
  "info": {
    "title": "FDE AI Solution Accelerator API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readyz",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/diagnostics/retrieval/{correlation_id}": {
      "get": {
        "tags": [
          "retrieval diagnostics"
        ],
        "summary": "Get Retrieval Diagnostics",
        "operationId": "get_retrieval_diagnostics_diagnostics_retrieval__correlation_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "correlation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "title": "Correlation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrievalDiagnosticsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "403": {
            "description": "Insufficient app role."
          },
          "503": {
            "description": "Identity, scope, or audit persistence is unavailable."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audit-events": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Query Audit Events",
        "operationId": "query_audit_events_audit_events_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "event_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/EventType"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Event Type"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "403": {
            "description": "Insufficient app role."
          },
          "503": {
            "description": "Identity, scope, or audit persistence is unavailable."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chat/stream": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Stream Chat",
        "operationId": "stream_chat_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Server-sent events. Each frame has an event name and JSON data. Answered turns emit token frames followed by citations and done; insufficient evidence emits abstention and done; policy handoffs emit approval and done.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-sse-events": {
                  "token": {
                    "properties": {
                      "text": {
                        "title": "Text",
                        "type": "string"
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "title": "TokenEvent",
                    "type": "object"
                  },
                  "citations": {
                    "$defs": {
                      "CitationItem": {
                        "properties": {
                          "chunk_id": {
                            "title": "Chunk Id",
                            "type": "string"
                          },
                          "document_title": {
                            "title": "Document Title",
                            "type": "string"
                          },
                          "source_uri": {
                            "title": "Source Uri",
                            "type": "string"
                          }
                        },
                        "required": [
                          "chunk_id",
                          "document_title",
                          "source_uri"
                        ],
                        "title": "CitationItem",
                        "type": "object"
                      }
                    },
                    "properties": {
                      "citations": {
                        "items": {
                          "$ref": "#/$defs/CitationItem"
                        },
                        "title": "Citations",
                        "type": "array"
                      }
                    },
                    "required": [
                      "citations"
                    ],
                    "title": "CitationsEvent",
                    "type": "object"
                  },
                  "approval": {
                    "$defs": {
                      "ApprovalCard": {
                        "properties": {
                          "approval_id": {
                            "title": "Approval Id",
                            "type": "string"
                          },
                          "tool_name": {
                            "title": "Tool Name",
                            "type": "string"
                          },
                          "status": {
                            "const": "pending",
                            "default": "pending",
                            "title": "Status",
                            "type": "string"
                          }
                        },
                        "required": [
                          "approval_id",
                          "tool_name"
                        ],
                        "title": "ApprovalCard",
                        "type": "object"
                      }
                    },
                    "properties": {
                      "approval": {
                        "$ref": "#/$defs/ApprovalCard"
                      }
                    },
                    "required": [
                      "approval"
                    ],
                    "title": "ApprovalEvent",
                    "type": "object"
                  },
                  "abstention": {
                    "properties": {
                      "reason": {
                        "title": "Reason",
                        "type": "string"
                      },
                      "evidence_ids": {
                        "items": {
                          "type": "string"
                        },
                        "title": "Evidence Ids",
                        "type": "array"
                      }
                    },
                    "required": [
                      "reason",
                      "evidence_ids"
                    ],
                    "title": "AbstentionEvent",
                    "type": "object"
                  },
                  "done": {
                    "properties": {},
                    "title": "DoneEvent",
                    "type": "object"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "403": {
            "description": "Insufficient app role."
          },
          "503": {
            "description": "The chat workflow is not configured."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuditEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "event_type": {
            "$ref": "#/components/schemas/EventType"
          },
          "outcome": {
            "$ref": "#/components/schemas/EventOutcome"
          },
          "correlation_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Correlation Id"
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Id"
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,128}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "occurred_at",
          "event_type",
          "outcome",
          "correlation_id",
          "actor_id",
          "approval_id",
          "tool_name"
        ],
        "title": "AuditEvent"
      },
      "AuditPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "AuditPage"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "EventOutcome": {
        "type": "string",
        "enum": [
          "approved",
          "denied",
          "succeeded",
          "failed"
        ],
        "title": "EventOutcome"
      },
      "EventType": {
        "type": "string",
        "enum": [
          "auth_failure",
          "approval",
          "tool_execution"
        ],
        "title": "EventType"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "ReadinessCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed",
              "not_configured"
            ],
            "title": "Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ReadinessCheck"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "RetrievalDiagnosticResult": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "document_title": {
            "type": "string",
            "title": "Document Title"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "reranker_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reranker Score"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "source_uri": {
            "type": "string",
            "title": "Source Uri"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "document_title",
          "score",
          "reranker_score",
          "text",
          "source_uri"
        ],
        "title": "RetrievalDiagnosticResult"
      },
      "RetrievalDiagnosticsResponse": {
        "properties": {
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "filters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Filters"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RetrievalDiagnosticResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "correlation_id",
          "query",
          "filters",
          "results"
        ],
        "title": "RetrievalDiagnosticsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
