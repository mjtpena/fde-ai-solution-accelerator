{
  "name": "fde-accelerator-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate:api && next build",
    "start": "next start",
    "generate:api": "openapi-typescript ../../contracts/api/openapi.json -o lib/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run generate:api && npm run typecheck && npm run test"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  }
}
